# Local development against the Firebase Emulator Suite.
# "demo-" project IDs need no real Firebase project and can never touch production.
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-seatlock.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://demo-seatlock-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=demo-seatlock
VITE_FIREBASE_APP_ID=demo-app-id
