{
  "rules": {
    "events": {
      "$eventId": {
        "meta": {
          ".read": true,
          ".write": "!data.exists()"
        },

        "seats": {
          ".read": true,
          "$seatId": {
            ".write": "!data.exists() || (auth != null && (data.child('status').val() !== 'sold') && (data.child('status').val() !== 'locked' || data.child('lockExpiresAt').val() < now || data.child('lockedBy').val() === auth.uid) && (newData.child('status').val() !== 'sold' || newData.child('soldTo').val() === auth.uid))",
            ".validate": "newData.hasChildren(['label','row','col','price','status'])",
            "status": { ".validate": "newData.val() === 'available' || newData.val() === 'locked' || newData.val() === 'sold'" },
            "lockedBy": { ".validate": "newData.val() === null || newData.val() === auth.uid" },
            "lockExpiresAt": { ".validate": "newData.val() === null || (newData.isNumber() && newData.val() <= now + 120000)" }
          }
        },

        "queue": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
